    {
      "name": "MCP Protocol",
      "item": [
        {
          "name": "initialize \u2014 handshake",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": {
              "raw": "{{mcp_base_url}}/mcp?x-api-key={{mcp_api_key}}",
              "host": [
                "{{mcp_base_url}}"
              ],
              "path": [
                "mcp"
              ],
              "query": [
                {
                  "key": "x-api-key",
                  "value": "{{mcp_api_key}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-03-26\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}"
            }
